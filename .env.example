# Copy this file to ~/.openclaw/iphone/config.env on each OpenClaw host.
# A repo-local .env is also supported for development and is ignored by Git.

# Required by unattended service wrappers. Prefer the physical UDID of the
# dedicated iPhone. Interactive CLI also accepts an unambiguous name/CoreDevice id.
OPENCLAW_IPHONE_DEVICE="My iPhone"

# Canonical checkout and WebDriverAgent locations for this host.
OPENCLAW_IPHONE_REPO_DIR="$HOME/.openclaw/repos/openclaw-iphone"
OPENCLAW_IPHONE_WDA_PATH="$HOME/.openclaw/iphone/WebDriverAgent"

# Signing settings used by `openclaw-iphone wda run` / `wda build`. Choose a unique
# bundle id for the Apple Developer account/team used on this host.
OPENCLAW_IPHONE_RUNNER_BUNDLE_ID="com.example.openclaw.WebDriverAgentRunner"
OPENCLAW_IPHONE_DEVELOPMENT_TEAM=""
OPENCLAW_IPHONE_DESTINATION_TIMEOUT="60"
# Optional prebuilt .xctestrun from `openclaw-iphone wda build --save-config` for fast WDA restarts:
# OPENCLAW_IPHONE_WDA_XCTESTRUN="$HOME/.openclaw/iphone/DerivedData/Build/Products/WebDriverAgentRunner_iphoneos.xctestrun"
# OPENCLAW_IPHONE_WDA_DERIVED_DATA="$HOME/.openclaw/iphone/DerivedData"
# Optional watchdog auto-kickstart after N consecutive WDA failures (0 = disabled):
# OPENCLAW_IPHONE_WATCHDOG_RESTART_AFTER="3"
# Optional cookies for `openclaw-iphone media fetch` (Instagram/TikTok login-gated downloads; chmod 600):
# OPENCLAW_IPHONE_MEDIA_COOKIES="$HOME/.openclaw/secrets/instagram-cookies.txt"
# OPENCLAW_IPHONE_MEDIA_COOKIES_BROWSER="chrome"

# Do not set OPENCLAW_IPHONE_WDA_URL for normal USB-connected operation.
# The CLI resolves the live CoreDevice WDA URL dynamically from the iPhone.

# Optional goal navigation (docs/goal.md). Off unless enabled. Sends each step's
# screenshot and screen text to OpenAI's Decisions API. Keep this file chmod 600.
# `openclaw-iphone goal setup` writes these; the first key found is used:
# OPENCLAW_IPHONE_OPENAI_API_KEY, then the file in OPENCLAW_IPHONE_OPENAI_API_KEY_FILE,
# then OPENAI_API_KEY from the environment. Uses gpt-6-luna.
OPENCLAW_IPHONE_GOAL_ENABLED="0"
# Provider defaults to openai. Supported: openai (gpt-6-luna), liquid (LFM-d1: d1.2 / d1.2-ultra / local d1-omni-*), typesafe (jev-1.14.0).
# OPENCLAW_IPHONE_GOAL_PROVIDER="liquid"
# OPENCLAW_IPHONE_GOAL_MODEL="d1.2"
# Optional override for Box visual grounding (defaults to 1 for d1.2*, 0 for local d1-omni-*):
# OPENCLAW_IPHONE_GOAL_VISION_BOX="0"
# OPENCLAW_IPHONE_LIQUID_API_KEY=""
# OPENCLAW_IPHONE_LIQUID_API_KEY_FILE="$HOME/.secrets/liquid.env"
# OPENCLAW_IPHONE_LIQUID_BASE_URL="https://api.liquid.ai/decisions/v1"  # or http://127.0.0.1:8781/v1 for local MLX d1-omni-600M
# Optional local Apple Silicon MLX d1-omni-600M server (`openclaw-iphone d1 install && openclaw-iphone d1 serve`):
# OPENCLAW_IPHONE_MLX_MODEL="LiquidAI/d1-omni-600M-MLX-8bit"
# OPENCLAW_IPHONE_MLX_VENV="$HOME/.openclaw/iphone/mlx-venv"
# OPENCLAW_IPHONE_MLX_PORT="8781"
# Optional local loopback d1-omni privacy guard (screens for passwords/OTPs/payments before cloud calls):
# OPENCLAW_IPHONE_LOCAL_GUARD_URL="http://127.0.0.1:8781/v1"
# OPENCLAW_IPHONE_LOCAL_GUARD_MODEL="LiquidAI/d1-omni-600M-MLX-8bit"
# OPENCLAW_IPHONE_TYPESAFE_API_KEY_FILE="$HOME/.openclaw/secrets/unblock-memory-typesafe.env"
OPENCLAW_IPHONE_OPENAI_API_KEY=""
# OPENCLAW_IPHONE_OPENAI_API_KEY_FILE="$HOME/.secrets/openai.key"
# OPENCLAW_IPHONE_OPENAI_BASE_URL="https://api.openai.com/v1"
